{
  "manifest_version": 3,
  "name": "言迹 ContextTrace",
  "version": "0.1.0",
  "description": "在 AI 对话网站（DeepSeek / Kimi / 豆包 / ChatGPT …）提取并检索已沉淀的记忆。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "言迹 ContextTrace",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chat.deepseek.com/*",
        "*://kimi.moonshot.cn/*",
        "*://kimi.com/*",
        "*://www.doubao.com/*",
        "*://doubao.com/*",
        "*://chat.openai.com/*",
        "*://chatgpt.com/*",
        "*://gemini.google.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "sidepanel.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
